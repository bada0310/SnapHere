# Copy this file to .env and fill in local values.

# Google Maps Platform API key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google OAuth 2.0 client ID (do not put a client secret in a mobile app)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# Korea Tourism Organization TourAPI
TOUR_API_SERVICE_KEY=your_tour_api_service_key

# Percona PostgreSQL 17.10.2 + PostGIS 3.6.2 (custom image)
DB_URL=jdbc:postgresql://localhost:5432/snaphere
DB_USERNAME=snaphere
DB_PASSWORD=snaphere

# Redis view counter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Local value must be at least 32 bytes. Use a secret manager in production.
SNAPHERE_JWT_SECRET=replace_with_at_least_32_random_bytes
SNAPHERE_TERMS_VERSION=2026-08-01
